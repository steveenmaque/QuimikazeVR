      m_Calls: []
  m_text: "Es la parte m\xE1s peque\xF1a de un elemento.\n\nEn el centro tiene un <color=#FF6B6B><b>n\xFAcleo</b></color> con <color=#FF6B6B>protones (+)</color> y, normalmente, <color=#B0BEC5>neutrones</color>. El hidr\xF3geno-1 no tiene neutrones. Los <color=#4FC3F7>electrones (-)</color> se describen mediante estados cu\xE1nticos.\n\nEl n\xFAmero de protones (<b>n\xFAmero at\xF3mico Z</b>) decide qu\xE9 elemento es."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: b780b1bd0a1951c4599d0cbb8ac5d019, type: 2}

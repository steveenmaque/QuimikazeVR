      m_Calls: []
  m_text: "<color=#FFC34D>MIRA</color> un elemento: se ilumina y aparece su ficha.\n<color=#FFC34D>TOCA EL BOT\xD3N DEL VISOR</color> o <color=#4DCC66>A</color>: entrar / pulsar.\n<color=#FFC34D>MANT\xC9N PULSADO</color> el bot\xF3n del visor o <color=#FFCC33>Y</color>: recentrar la vista.\n<color=#FFC34D>JOYSTICK IZQUIERDO</color>: caminar.   <color=#FFC34D>DERECHO</color>: girar.\n<color=#F25959>B</color>: volver a la tabla.   <color=#4D99FF>X</color>: cambiar modelo del \xE1tomo.\n<color=#FFC34D>L1 / R1</color>: ajustar las lentes si ves doble.\nPon el celular en el visor <color=#FFC34D>del lado que quieras</color>: la pantalla gira sola."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: b780b1bd0a1951c4599d0cbb8ac5d019, type: 2}
